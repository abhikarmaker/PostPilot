# Server
PORT=4000
WEB_BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postpilot:postpilot@localhost:5432/postpilot?schema=public"

# Auth (single-user: this is your own dashboard login password)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-a-strong-password

# Meta (Facebook/Instagram) Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/auth/meta/callback

# Object storage (S3-compatible: AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=postpilot-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
