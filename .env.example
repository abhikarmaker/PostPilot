# Used by docker-compose.yml when deploying all services (api, worker, web,
# postgres, redis, caddy) together on a single always-on server, for $0/month.
# Copy to .env and fill in real values before running `docker compose up -d --build`.
# See README.md "Deploying for $0/month" for the full walkthrough.

# Free DuckDNS subdomains pointing at your server's public IP (register two
# at duckdns.org -- one for the dashboard, one for the API). Caddy uses these
# to request free Let's Encrypt certificates automatically.
WEB_DOMAIN=your-app.duckdns.org
API_DOMAIN=your-app-api.duckdns.org

# Public URL of the web dashboard (used for OAuth redirects back to the UI)
WEB_BASE_URL=https://your-app.duckdns.org
# Base URL the browser uses to reach the API (baked into the web build)
NEXT_PUBLIC_API_BASE_URL=https://your-app-api.duckdns.org

# Auth -- this is YOUR dashboard login, not a multi-user system
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-a-strong-password

# Meta (Facebook/Instagram) Graph API -- see README for how to create this
# app and avoid Meta's App Review process for personal use
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-app-api.duckdns.org/auth/meta/callback

# Object storage -- Cloudflare R2 free tier (10GB storage, no egress fees).
# STORAGE_ENDPOINT: https://<your-account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY: from an R2 API token
# STORAGE_PUBLIC_BASE_URL: the bucket's public r2.dev URL (or custom domain)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=postpilot-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# How often the scheduler checks for due posts (cron expression)
POLL_CRON=* * * * *
