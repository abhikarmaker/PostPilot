# Used by docker-compose.yml when deploying all services (api, worker, web,
# postgres, redis) together on a single always-on server.
# Copy to .env and fill in real values before running `docker compose up -d --build`.

# Public URL of the web dashboard (used for OAuth redirects back to the UI)
WEB_BASE_URL=http://localhost:3000
# Base URL the browser uses to reach the API (baked into the web build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Auth -- this is YOUR dashboard login, not a multi-user system
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-a-strong-password

# Meta (Facebook/Instagram) Graph API -- see README for how to create this
# app and avoid Meta's App Review process for personal use
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/auth/meta/callback

# Object storage (S3-compatible: AWS S3 or Cloudflare R2). Media must be
# reachable at a public URL for Meta to fetch it.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=postpilot-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# How often the scheduler checks for due posts (cron expression)
POLL_CRON=* * * * *
