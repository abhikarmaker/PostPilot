# Personal single-user deployment: runs the TypeScript source directly via
# tsx rather than a separate compile step, trading a larger image for a
# much simpler build.
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY . .
RUN npm run db:generate

ENV NODE_ENV=production
EXPOSE 4000

# migrate deploy is safe to run on every boot (Prisma uses an advisory lock
# and skips already-applied migrations).
CMD ["sh", "-c", "npx prisma migrate deploy --schema packages/db/prisma/schema.prisma && npx tsx apps/api/src/index.ts"]
